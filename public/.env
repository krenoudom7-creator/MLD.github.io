# ---------- existing ----------
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
TOKEN_TTL=8h

# ---------- KHQR checkout (Bakong) ----------
# sandbox (default, uses the NBC SIT API) or production
BAKONG_ENV=sandbox
# Token e-mailed by NBC (register at https://sit-api-bakong.nbc.gov.kh/ for sandbox, https://api-bakong.nbc.gov.kh/ for production).
# NEVER put this in index.html / pay.html or commit it to git.
BAKONG_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJkYXRhIjp7ImlkIjoiNmI5OGRjNzY3NzQzNDhkYyJ9LCJpYXQiOjE3OTI4NTI4OTMsImV4cCI6MTgwMDYyODg5M30.VeGHoHseIH_MlElerhcA3decm5uoot2E4Jh3oOzyJNs
# Optional: override the API base URL (e.g. a relay hosted in Cambodia that YOU control). Leave empty to use the official URL.
BAKONG_BASE_URL=

# Your Bakong account id as encoded in your static KHQR (tag 29/30, first field). Example format: name@bank
BAKONG_ACCOUNT_ID=
# individual (default) or merchant. merchant also needs BAKONG_MERCHANT_ID and BAKONG_ACQUIRING_BANK
BAKONG_ACCOUNT_TYPE=individual
# Name EXACTLY as printed on your static QR (ASCII, max 25 chars) and city (max 15)
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=Phnom Penh
# Account number per currency (individual QR, sub-field 01 of tag 29). Check these against your own static QR!
BAKONG_ACCOUNT_INFO_USD=
BAKONG_ACCOUNT_INFO_KHR=
BAKONG_ACQUIRING_BANK=
BAKONG_MERCHANT_ID=
BAKONG_MCC=5999
BAKONG_STORE_LABEL=Mlob Doung Coffee
# Optional strict check: only accept transactions whose toAccountId equals this value (see PAYMENT_SETUP.md before enabling)
BAKONG_EXPECT_TO_ACCOUNT=

# QR lifetime, extra minutes we keep verifying after expiry, and how long an unpaid order holds its stock after the QR expired
KHQR_EXPIRE_MINUTES=10
KHQR_GRACE_MINUTES=5
KHQR_ORDER_HOLD_MINUTES=15

# Reports use Cambodia time (UTC+7)
TZ_OFFSET=7
