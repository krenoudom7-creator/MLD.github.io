# ចម្លងឯកសារនេះទៅជា .env រួចកែតម្លៃ
PORT=3000

# គណនី Admin ដំបូង (ប្រើតែពេលចាប់ផ្តើមលើកដំបូង ពេល database នៅទទេ)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=111222

# (ជម្រើស) ទុកទទេ = បង្កើតស្វ័យប្រវត្តិ ហើយរក្សាទុកក្នុង data/jwt.secret
# JWT_SECRET=
# TOKEN_TTL=8h

# (ជម្រើស) បើ Front-end នៅ domain ផ្សេង សូមដាក់ domain នោះ (បំបែកដោយ ,)
# CORS_ORIGIN=https://your-site.com
