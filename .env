# ចម្លងឯកសារនេះទៅជា .env រួចកែតម្លៃ
PORT=3000

# គណនី Admin ដំបូង (ប្រើតែពេលចាប់ផ្តើមលើកដំបូង ពេល database នៅទទេ)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=111222

# (ជម្រើស) ទុកទទេ = បង្កើតស្វ័យប្រវត្តិ ហើយរក្សាទុកក្នុង data/jwt.secret
# JWT_SECRET=
# TOKEN_TTL=8h

# (ជម្រើស) បើ Front-end នៅ domain ផ្សេង សូមដាក់ domain នោះ (បំបែកដោយ ,)
# CORS_ORIGIN=https://your-site.com
# ===== បន្ថែមទៅក្នុង .env (ទាំងអស់ជាជម្រើស) =====

# --- Telegram (បង្កើត Bot តាម @BotFather ហើយប្រើ Chat ឯកជនរបស់ម្ចាស់ហាងតែម្នាក់) ---
# Backup ដែលផ្ញើមាន hash ពាក្យសម្ងាត់ Admin ដូច្នេះកុំប្រើ Group សាធារណៈ
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOW_STOCK=5            # ជូនដំណឹងពេលស្តុកធ្លាក់ដល់ចំនួននេះ
SUMMARY_HOUR=21        # ម៉ោងផ្ញើសរុបលក់ប្រចាំថ្ងៃ (ម៉ោងកម្ពុជា 0-23)

# --- ការពារការកម្ម៉ង់ក្លែងក្លាយ ---
PENDING_TTL_MIN=20     # ការកម្ម៉ង់ដែលបុគ្គលិកមិនទាន់ទទួលយក និងមិនទាន់បង់ ត្រូវលុបដោយស្វ័យប្រវត្តិ (0 = បិទ)
PENDING_PER_IP=10      # ចំនួនការកម្ម៉ង់កំពុងរង់ចាំអតិបរមាក្នុង IP តែមួយ (0 = បិទ)

# --- CORS ---
# លំនាំដើមឥឡូវគឺបិទ (Front-end និង Backend នៅ Server តែមួយ)។
# បើ Front-end នៅ domain ផ្សេង (ឧ. GitHub Pages) ត្រូវដាក់ domain នោះ៖
# CORS_ORIGIN=https://yourname.github.io
